# ============================================================
# Argus Agent — Environment Variables Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
# For CI/CD use GitHub Actions secrets (see .github/workflows/ci.yml).
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=crud

# ── Spring Boot DB connection ────────────────────────────────
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# ── Jenkins ──────────────────────────────────────────────────
# Jenkins URL — use host.docker.internal if Jenkins runs on the host
JENKINS_URL=http://host.docker.internal:8080
JENKINS_USER=admin
# Create an API token in Jenkins → User → Configure → API Token
JENKINS_TOKEN=your-jenkins-api-token-here
JENKINS_JOB=your-default-job-name

# ── LLM (optional) ───────────────────────────────────────────
# Leave ANTHROPIC_API_KEY blank to fall back to Ollama
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me

# ── Slack alerts (optional) ──────────────────────────────────
# Create an Incoming Webhook at https://api.slack.com/messaging/webhooks
# Leave blank to disable Slack notifications
SLACK_WEBHOOK_URL=
