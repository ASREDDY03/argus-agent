{
  "title": "Argus Agent — Jenkins Pipelines",
  "uid": "jenkins-pipelines",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Total Builds",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(jenkins_builds_last_build_result_ordinal)", "legendFormat": "Total Builds" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "id": 2,
      "title": "Successful Builds",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "count(jenkins_builds_last_build_result_ordinal == 0)", "legendFormat": "Success" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 3,
      "title": "Failed Builds",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "count(jenkins_builds_last_build_result_ordinal == 1)", "legendFormat": "Failed" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }] } } }
    },
    {
      "id": 4,
      "title": "Jobs in Queue",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "jenkins_queue_size_value", "legendFormat": "Queued" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "yellow", "value": null }] } } }
    },
    {
      "id": 10,
      "title": "Job Success Rate — 5m (recorded)",
      "description": "Uses precomputed recording rule job:jenkins_success_rate:5m",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "job:jenkins_success_rate:5m", "legendFormat": "{{job}}" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",    "value": null },
            { "color": "yellow", "value": 0.7 },
            { "color": "green",  "value": 0.9 }
          ]}
        }
      }
    },
    {
      "id": 11,
      "title": "Avg Build Duration — 10m (recorded)",
      "description": "Uses precomputed recording rule job:jenkins_avg_duration:10m",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "job:jenkins_avg_duration:10m", "legendFormat": "{{job}}" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 30 },
            { "color": "red",    "value": 60 }
          ]}
        }
      }
    },
    {
      "id": 5,
      "title": "Build Duration per Job (last build — raw)",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "jenkins_builds_last_build_duration_milliseconds / 1000", "legendFormat": "{{job}}" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 30 },
            { "color": "red", "value": 60 }
          ]}
        }
      }
    },
    {
      "id": 6,
      "title": "Build Result per Job",
      "type": "table",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "jenkins_builds_last_build_result_ordinal", "legendFormat": "{{job}}", "instant": true }
      ],
      "transformations": [{ "id": "organize", "options": {} }]
    },
    {
      "id": 7,
      "title": "Build Duration Trend — all jobs (recorded)",
      "description": "Uses precomputed recording rule job:jenkins_avg_duration:10m",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "job:jenkins_avg_duration:10m", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 12,
      "title": "Anomaly Rate — 5m (recorded)",
      "description": "Uses precomputed recording rule job:jenkins_anomaly_rate:5m",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "job:jenkins_anomaly_rate:5m", "legendFormat": "{{job}}" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 0.1 },
            { "color": "red",    "value": 0.3 }
          ]}
        }
      }
    },
    {
      "id": 8,
      "title": "Executor Usage",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "jenkins_executor_in_use_value", "legendFormat": "In Use" },
        { "expr": "jenkins_executor_count_value",  "legendFormat": "Total" }
      ]
    },
    {
      "id": 9,
      "title": "Jenkins JVM Heap",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 44, "w": 24, "h": 6 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "jenkins_memory_heap_used / 1024 / 1024", "legendFormat": "Heap Used (MB)" }],
      "fieldConfig": { "defaults": { "unit": "decmbytes" } }
    }
  ],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {}
}
